<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <title>Tetris?</title>
  <style>
    *{
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    body {
      background: black;
      color: #fff;
      text-align: center;
    }
    canvas {
      border: 1px solid #fff;
      background: #000;
    }
    #score {
      font-size: 24px;
      margin: 10px;
    }

    .link{
        text-decoration: none;
        color: white;
        padding: 20px;
    }
  </style>
</head>
<body>
  <h1>Tetris Mini Game</h1>
    <div id="score" data-logged-in="<%= locals.user ? 'true' : 'false' %>">分數: 0</div>
    <% if (locals.user) { %>
        <div>Highest Score: <span id="high-score"><%= user.high_score %></span></div>
    <% } %>
  
  <canvas id="tetris" width="240" height="400"></canvas>
    <nav>
    <% if (locals.user) { %>
      Welcome, <%= user.username %> |
      <a href="/log-out" class="link">Log Out</a>
    <% } else { %>
      <a href="/log-in" class="link">Log In</a> |
      <a href="/sign-up" class="link">Sign Up</a>
    <% } %>
  </nav>


  <script>
    const canvas = document.getElementById('tetris');
    const context = canvas.getContext('2d');
    context.scale(20, 20); // 放大 20 倍，對應 12x20 格子

    // 建立 12 欄、20 列的遊戲盤面矩陣
    function createMatrix(w, h) {
      const matrix = [];
      while (h--) matrix.push(new Array(w).fill(0));
      return matrix;
    }

    // 各種方塊形狀定義
    function createPiece(type) {
      if (type === 'I') return [[0,1,0,0],[0,1,0,0],[0,1,0,0],[0,1,0,0]];
      if (type === 'L') return [[0,2,0],[0,2,0],[0,2,2]];
      if (type === 'J') return [[0,3,0],[0,3,0],[3,3,0]];
      if (type === 'O') return [[4,4],[4,4]];
      if (type === 'Z') return [[5,5,0],[0,5,5],[0,0,0]];
      if (type === 'S') return [[0,6,6],[6,6,0],[0,0,0]];
      if (type === 'T') return [[0,7,0],[7,7,7],[0,0,0]];
    }

    const colors = [
      null,
      '#00f0f0', // I - 青色
      '#f0a000', // L - 橘色
      '#0000f0', // J - 藍色
      '#f0f000', // O - 黃色
      '#f00000', // Z - 紅色
      '#00f000', // S - 綠色
      '#a000f0'  // T - 紫色
    ];

    // 繪製矩陣到畫布
    function drawMatrix(matrix, offset) {
      matrix.forEach((row, y) => {
        row.forEach((value, x) => {
          if (value !== 0) {
            context.fillStyle = colors[value];
            context.fillRect(x + offset.x, y + offset.y, 1, 1);
          }
        });
      });
    }

    // 碰撞偵測
    function collide(arena, player) {
      const [m, o] = [player.matrix, player.pos];
      for (let y = 0; y < m.length; ++y) {
        for (let x = 0; x < m[y].length; ++x) {
          if (m[y][x] !== 0 &&
              (arena[y + o.y] && arena[y + o.y][x + o.x]) !== 0) {
            return true;
          }
        }
      }
      return false;
    }

    // 方塊固定到底部/已有方塊上
    function merge(arena, player) {
      player.matrix.forEach((row, y) => {
        row.forEach((value, x) => {
          if (value !== 0) {
            arena[y + player.pos.y][x + player.pos.x] = value;
          }
        });
      });
    }

    // 消除滿行與計分
    function arenaSweep() {
      let rowCount = 1;
      outer: for (let y = arena.length - 1; y > 0; --y) {
        for (let x = 0; x < arena[y].length; ++x) {
          if (arena[y][x] === 0) continue outer;
        }
        const row = arena.splice(y, 1)[0].fill(0);
        arena.unshift(row);
        ++y;
        player.score += rowCount * 10;
        rowCount *= 2;
      }
    }

    // 方塊旋轉演算法（轉置 + 反轉）
    function rotate(matrix, dir) {
      for (let y = 0; y < matrix.length; ++y) {
        for (let x = 0; x < y; ++x) {
          [matrix[x][y], matrix[y][x]] = [matrix[y][x], matrix[x][y]];
        }
      }
      if (dir > 0) matrix.forEach(row => row.reverse());
      else matrix.reverse();
    }

    // 玩家方塊旋轉並防止穿牆
    function playerRotate(dir) {
      const pos = player.pos.x;
      let offset = 1;
      rotate(player.matrix, dir);
      while (collide(arena, player)) {
        player.pos.x += offset;
        offset = -(offset + (offset > 0 ? 1 : -1));
        if (offset > player.matrix[0].length) {
          rotate(player.matrix, -dir);
          player.pos.x = pos;
          return;
        }
      }
    }

    // 方塊自然下落或手動加速
    function playerDrop() {
      player.pos.y++;
      if (collide(arena, player)) {
        player.pos.y--;
        merge(arena, player);
        playerReset();
        arenaSweep();
        updateScore();
      }
      dropCounter = 0;
    }

    // 水平移動
    function playerMove(dir) {
      player.pos.x += dir;
      if (collide(arena, player)) {
        player.pos.x -= dir;
      }
    }

    // 重置或生成新方塊
    function playerReset() {
      const pieces = 'ILJOZST';
      player.matrix = createPiece(pieces[Math.floor(Math.random() * pieces.length)]);
      player.pos.y = 0;
      player.pos.x = Math.floor(arena[0].length / 2) - Math.floor(player.matrix[0].length / 2);
      
      // 生成即碰撞代表遊戲結束
      if (collide(arena, player)) {
        arena.forEach(row => row.fill(0));
        player.score = 0;
        updateScore();
      }
    }

   function updateScore() {
  document.getElementById('score').innerText = 'Score: ' + player.score;

  const isLoggedIn = document.getElementById('score').dataset.loggedIn === 'true';

  if (isLoggedIn) {
    fetch('/save-score', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ score: player.score })
    })
      .then(res => res.json())
      .then(data => {
        const highScoreEl = document.getElementById('high-score');
        if (highScoreEl && player.score > parseInt(highScoreEl.innerText)) {
          highScoreEl.innerText = player.score;
        }
      });
  }
}

    function draw() {
      context.fillStyle = '#000';
      context.fillRect(0, 0, canvas.width, canvas.height);
      drawMatrix(arena, {x: 0, y: 0});
      drawMatrix(player.matrix, player.pos);
    }

    let dropCounter = 0;
    let dropInterval = 1000; // 每秒下落一格
    let lastTime = 0;

    // 主遊戲循環
    function update(time = 0) {
      const deltaTime = time - lastTime;
      lastTime = time;

      dropCounter += deltaTime;
      if (dropCounter > dropInterval) {
        playerDrop();
      }

      draw();
      requestAnimationFrame(update);
    }

    // 鍵盤控制監聽
    document.addEventListener('keydown', event => {
      if (event.key === 'ArrowLeft') playerMove(-1);
      else if (event.key === 'ArrowRight') playerMove(1);
      else if (event.key === 'ArrowDown') playerDrop();
      else if (event.key === 'q' || event.key === 'Q') playerRotate(-1); // 逆時針
      else if (event.key === 'w' || event.key === 'W' || event.key === 'ArrowUp') playerRotate(1); // 順時針
    });

    const arena = createMatrix(12, 20);
    const player = {
      pos: {x: 0, y: 0},
      matrix: null,
      score: 0
    };

    playerReset();
    updateScore();
    update();
  </script>
</body>
</html>
